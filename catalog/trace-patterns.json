{
  "schemaVersion": 1,
  "description": "Review traces that must not appear in a review copy or in any path given to an agent (SPEC 15.5). Every regex is compiled with the flags shown plus 'g' and 'u'. data: true marks the few patterns that are unambiguous even in a short value of a LARGE data file (.csv .tsv .jsonl .ndjson .json over 1 MiB or 2 000 rows): short values (numbers, names) are scanned with them only, because ratings, 'panel', 'reviewer' and 'round 3' are ordinary words and values of real data (a shop rating 9,5, solar panels). Prose files, small data files and every prose-like value of a large data file (4 or more words, or 30 or more characters) are scanned with every pattern. scope: 'both' = file contents and path components; 'path' = path components only. strip.json traceAllow removes hits.",
  "patterns": [
    { "id": "T-SCORE-RU", "regex": "оценк(?:а|и|у|ой|ам)\\s+(?:проверяющ|панели|ревьюер)", "flags": "i", "lang": "ru", "scope": "both", "data": true, "why": "score table or score sentence of earlier reviews (\"оценки проверяющих\")" },
    { "id": "T-AVG-EN", "regex": "\\baverage\\s+(?:panel\\s+|review\\s+)?scores?\\b", "flags": "i", "lang": "en", "scope": "both", "why": "average score of earlier reviews" },
    { "id": "T-AVG-RU", "regex": "средн(?:ий|яя|его|ей|юю|ие|их)\\s+(?:балл|оценк)", "flags": "i", "lang": "ru", "scope": "both", "why": "average score of earlier reviews (\"средний балл\", \"средняя оценка\")" },
    { "id": "T-OUT-OF-10", "regex": "\\b\\d{1,2}[.,]\\d\\s*/\\s*10\\b", "flags": "", "lang": "any", "scope": "both", "why": "a score written as N.N/10" },
    { "id": "T-9-5", "regex": "\\b9[.,]5\\b", "flags": "", "lang": "any", "scope": "both", "why": "the old stop threshold 9.5 / 9,5" },
    { "id": "T-ROUND-EN", "regex": "\\brounds?[\\s_#-]*\\d", "flags": "i", "lang": "en", "scope": "both", "why": "round number of an earlier review (\"round 3\", \"ROUND3\")" },
    { "id": "T-ROUND-RU", "regex": "(?<![\\p{L}])круг(?:а|е|у|ом|и|ов)?[\\s_#№-]*\\d", "flags": "i", "lang": "ru", "scope": "both", "why": "round number of an earlier review (\"круг 3\")" },
    { "id": "T-RAUND-RU", "regex": "(?<![\\p{L}])раунд", "flags": "i", "lang": "ru", "scope": "both", "why": "round word (\"раунд\")" },
    { "id": "T-REVIEWER-EN", "regex": "\\breviewers?\\b", "flags": "i", "lang": "en", "scope": "both", "why": "mentions reviewers of the work" },
    { "id": "T-REVIEWER-RU", "regex": "проверяющ", "flags": "i", "lang": "ru", "scope": "both", "why": "mentions reviewers of the work (\"проверяющие\")" },
    { "id": "T-PANEL-EN", "regex": "\\bpanel(?:s|ists?)?\\b", "flags": "i", "lang": "en", "scope": "both", "why": "mentions a review panel" },
    { "id": "T-PANEL-RU", "regex": "(?<![\\p{L}])панел(?:ь|и|ью|ей|ям|ями|ях)(?![\\p{L}])", "flags": "i", "lang": "ru", "scope": "both", "why": "mentions a review panel (\"панель\" as a word)" },
    { "id": "T-CANARY", "regex": "\\bcanar(?:y|ies)\\b", "flags": "i", "lang": "en", "scope": "both", "why": "mentions planted test errors" },
    { "id": "T-PODLOZH-RU", "regex": "подлож", "flags": "i", "lang": "ru", "scope": "both", "why": "mentions planted errors (\"подложенные\")" },
    { "id": "T-FIXED-RU", "regex": "(?<![\\p{L}])исправлен(?:о|а|ы)(?![\\p{L}])", "flags": "i", "lang": "ru", "scope": "both", "why": "claims something was already fixed (\"исправлено\")" },
    { "id": "T-FIXED-IN-EN", "regex": "\\bfixed\\s+in\\s+(?:round|version|v\\s*\\d)", "flags": "i", "lang": "en", "scope": "both", "why": "claims something was fixed in an earlier round or version" },
    { "id": "T-VERSION-RU", "regex": "(?<![\\p{L}])верси(?:я|и|ю|ей)\\s*(?:№?\\s*\\d+\\s+(?:(?:этого|данного|нашего|вашего|моего|настоящего|текущего|нового|исходного|общего)\\s+)?(?:документ(?:а|е|у|ом|ы)?|план(?:а|е|у|ом|ы)?|отч[её]т(?:а|е|у|ом|ы)?|текст(?:а|е|у|ом)?|черновик(?:а|е|у|ом|и)?|материал(?:а|е|у|ом)|стать(?:я|и|ю|е|ей)|описани(?:я|ю|и|ем)|презентаци(?:я|и|ю|ей)|договор(?:а|е|у|ом)?|письм(?:о|а|е|у|ом)|брошюр(?:а|ы|е|у|ой)|листовк(?:а|и|е|у|ой)|рукопис(?:ь|и|ью))(?![\\p{L}])|(?:документ(?:а|е|у|ом|ы)?|план(?:а|е|у|ом|ы)?|отч[её]т(?:а|е|у|ом|ы)?|текст(?:а|е|у|ом)?|черновик(?:а|е|у|ом|и)?|материал(?:а|е|у|ом)|стать(?:я|и|ю|е|ей)|описани(?:я|ю|и|ем)|презентаци(?:я|и|ю|ей)|договор(?:а|е|у|ом)?|письм(?:о|а|е|у|ом)|брошюр(?:а|ы|е|у|ой)|листовк(?:а|и|е|у|ой)|рукопис(?:ь|и|ью))(?![\\p{L}])\\s*№?\\s*\\d+)", "flags": "i", "lang": "ru", "scope": "both", "why": "numbered version of the reviewed work itself (\"версия 3 плана\", \"версия 3 этого плана\", \"версия документа 2\"); a bare \"версия 1\" or \"версия 2 приложения\" is product numbering and is not a trace" },
    { "id": "T-VERSION-STAMP-RU", "regex": "(?<![\\p{L}])верси(?:я|и|ю|ей)\\s*№?\\s*\\d+\\s*[.,;:—–-]?\\s*(?:собран|сгенерирован|сформирован|составлен|подготовлен)\\p{L}*", "flags": "i", "lang": "ru", "scope": "both", "why": "a build stamp of the work itself (\"Версия 7. Собрано 05.10.2026\")" },
    { "id": "T-VERSION-COMPARE-RU", "regex": "(?<![\\p{L}])(?:по\\s+сравнению\\s+с|в\\s+сравнении\\s+с|относительно)\\s+верси(?:я|и|ю|ей)\\s*№?\\s*\\d+", "flags": "i", "lang": "ru", "scope": "both", "why": "compares with an earlier numbered version (\"по сравнению с версией 2\")" },
    { "id": "T-VERSION-FIXED-RU", "regex": "(?<![\\p{L}])во?\\s+верси(?:и)\\s*№?\\s*\\d+\\s*[,:;—–-]?\\s*(?:уже\\s+|было\\s+|были\\s+)?(?:исправ|устран|поправ|учт[её]н|переработ|доработ|уточн[её]н|скорректир|пересмотр)\\p{L}*", "flags": "i", "lang": "ru", "scope": "both", "why": "says what was corrected in an earlier numbered version (\"в версии 3 исправлено\")" },
    { "id": "T-VERSION-PREV-RU", "regex": "(?<![\\p{L}])(?:предыдущ|прошл|прежн)\\p{L}*\\s+верси(?:я|и|ю|ей|ях|ям)(?![\\p{L}])", "flags": "i", "lang": "ru", "scope": "both", "why": "mentions the previous version of the work (\"предыдущая версия\")" },
    { "id": "T-VERSION-OF-EN", "regex": "\\bversion\\s+\\d+\\s+of\\s+(?:the\\s+|this\\s+|that\\s+|our\\s+|my\\s+|your\\s+|its\\s+)?(?:document|plan|report|text|draft|essay|article|paper|brief|proposal|file|page|copy|description|presentation|leaflet|work|material|content|manuscript|letter|contract|summary|memo|submission)\\b", "flags": "i", "lang": "en", "scope": "both", "why": "numbered version of the reviewed work itself (\"version 3 of the plan\"); \"version 2 of the Shopify API\" is product numbering and is not a trace" },
    { "id": "T-VERSION-COMPARE-EN", "regex": "\\b(?:compared\\s+(?:to|with)|relative\\s+to|as\\s+opposed\\s+to)\\s+version\\s+\\d+\\b", "flags": "i", "lang": "en", "scope": "both", "why": "compares with an earlier numbered version (\"compared to version 2\")" },
    { "id": "T-VERSION-PREV-EN", "regex": "\\b(?:previous|prior|earlier)\\s+version\\b", "flags": "i", "lang": "en", "scope": "both", "why": "mentions the previous version of the work (\"previous version\")" },
    { "id": "T-VERSION-ARROW", "regex": "(?<![\\p{L}\\d])v\\s*\\d+(?:\\.\\d+)*\\s*(?:→|->|-->|=>|—>|➜)\\s*v\\s*\\d+", "flags": "i", "lang": "any", "scope": "both", "why": "a version-to-version change (\"v2 → v3\")" },
    { "id": "T-VERSION-NOUN-FIRST-RU", "regex": "(?<![\\p{L}])(?:документ(?:а|е|у|ом|ы)?|план(?:а|е|у|ом|ы)?|отч[её]т(?:а|е|у|ом|ы)?|текст(?:а|е|у|ом)?|черновик(?:а|е|у|ом|и)?|стать(?:я|и|ю|е|ей)|презентаци(?:я|и|ю|ей)|договор(?:а|е|у|ом)?|письм(?:о|а|е|у|ом)|брошюр(?:а|ы|е|у|ой)|листовк(?:а|и|е|у|ой)|рукопис(?:ь|и|ью))\\s+верси(?:я|и|ю|ей)\\s*№?\\s*\\d+", "flags": "i", "lang": "ru", "scope": "both", "why": "numbered version of the reviewed work itself, noun first (\"документ версии 3\")" },
    { "id": "T-VERSION-REVIEW-RU", "regex": "(?<![\\p{L}])верси(?:я|и|ю|ей)\\s*№?\\s*\\d+(?:\\.\\d+)*\\s*(?:[(\\[][^)\\]\\n]{0,40}?(?:после\\s+(?:замечани|проверк|правок|правки|ревью|рецензи|согласовани|обратной\\s+связи)\\p{L}*|(?:учт[её]н|доработан|исправлен|переработан|скорректирован|пересмотрен)\\p{L}*|(?:замечани|правк|ревью|рецензи)\\p{L}*)|[:;,.—–-]\\s*(?:после\\s+(?:замечани|проверк|правок|правки|ревью|рецензи|согласовани|обратной\\s+связи)\\p{L}*|(?:учт[её]н|доработан|исправлен|переработан|скорректирован|пересмотрен)\\p{L}*|(?:замечани|правк|ревью|рецензи)\\p{L}*))", "flags": "i", "lang": "ru", "scope": "both", "why": "a heading or note that says what the earlier version went through (\"Версия 3 (после замечаний)\", \"Версия 2 — учтены замечания\", \"Версия 3 — доработана\")" },
    { "id": "T-VERSION-FROM-RU", "regex": "(?<![\\p{L}])(?:в\\s+отличие\\s+от|измен\\p{L}*\\s+(?:\\p{L}+\\s+){0,2}?(?:с|после)|правк\\p{L}*\\s+(?:с|после))\\s+верси(?:я|и|ю|ей)\\s*№?\\s*\\d+", "flags": "i", "lang": "ru", "scope": "both", "why": "a change note against an earlier numbered version (\"Что изменилось с версии 2\", \"в отличие от версии 2\")" },
    { "id": "T-VERSION-DONE-IN-RU", "regex": "(?<![\\p{L}])(?:обновлен|исправлен|доработан|переработан|уточн[её]н|скорректирован|пересмотрен|дополнен)\\p{L}*\\s+в\\s+верси(?:и)\\s*№?\\s*\\d+", "flags": "i", "lang": "ru", "scope": "both", "why": "says what was changed in an earlier numbered version (\"Обновлено в версии 4\")" },
    { "id": "T-VERSION-STRUCTURE-RU", "regex": "(?<![\\p{L}])во?\\s+верси(?:и)\\s*№?\\s*\\d+\\s*[,:;—–-]?\\s*(?:был\\p{L}*\\s+|уже\\s+)?(?:добавлен|удал[её]н|убран|переписан|дополнен)\\p{L}*\\s+(?:новый\\s+|новая\\s+|новое\\s+|целый\\s+)?(?:раздел|глав|абзац|параграф|пункт|секци)\\p{L}*", "flags": "i", "lang": "ru", "scope": "both", "why": "says which part of the text was added or removed in an earlier numbered version (\"в версии 3 добавлен раздел\")" },
    { "id": "T-VERSION-THIS-RU", "regex": "(?<![\\p{L}])(?:это|эта|данная|настоящая|текущая)\\s+верси(?:я|и|ю|ей)\\s*№?\\s*\\d+(?:\\.\\d+)*(?=\\s*[.!]?\\s*(?:$|<))", "flags": "im", "lang": "ru", "scope": "both", "why": "a line that only announces the number of this version (\"Это версия 3.\")" },
    { "id": "T-VERSION-ARROW-WORD", "regex": "(?<![\\p{L}])(?:верси(?:я|и|ю|ей)|version)\\s*№?\\s*\\d+(?:\\.\\d+)*\\s*(?:→|->|-->|=>|—>|➜)\\s*(?:верси(?:я|и|ю|ей)|version)\\s*№?\\s*\\d+", "flags": "i", "lang": "any", "scope": "both", "why": "a change from one numbered version to another (\"версия 2 → версия 3\", \"version 2 -> version 3\")" },
    { "id": "T-VERSION-SINCE-EN", "regex": "\\b(?:(?:changes?|changed|differences?|edits?|edited|revisions?|revised|corrections?|corrected|fixes|fixed)\\s+(?:made\\s+)?since|in\\s+contrast\\s+to)\\s+version\\s+\\d+", "flags": "i", "lang": "en", "scope": "both", "why": "a change note against an earlier numbered version (\"changes since version 2\")" },
    { "id": "T-VERSION-REVIEW-EN", "regex": "\\bversion\\s+\\d+(?:\\.\\d+)*\\s*(?:[(\\[][^)\\]\\n]{0,40}?\\b(?:after[\\s-]+(?:review|feedback|comments|edits|revisions?)|post[\\s-]+(?:review|feedback)|fixed\\s+(?:typos?|errors?)|revised|corrected)|(?:[—–:;,.]|-+)\\s*(?:after\\s+(?:review|feedback|comments)\\b|(?:fixed|corrected)\\s+(?:the\\s+)?(?:typos?|errors?|mistakes?|wording|issues?|problems?)\\b|(?:revised|addressed|incorporat\\p{L}*)\\b))", "flags": "i", "lang": "en", "scope": "both", "why": "a heading or note that says what the earlier version went through (\"Version 3 (after review)\", \"Version 3 — fixed typos\")" },
    { "id": "T-DELIBERATE-EN", "regex": "\\bdeliberate(?:ly)?\\b", "flags": "i", "lang": "en", "scope": "both", "why": "tells readers a problem is intended (\"deliberate, don't flag\")" },
    { "id": "T-DELIBERATE-RU", "regex": "намеренн", "flags": "i", "lang": "ru", "scope": "both", "why": "tells readers a problem is intended (\"намеренно\")" },
    { "id": "T-VERIFIED-PANEL", "regex": "verified\\s+by\\s+the\\s+panel", "flags": "i", "lang": "en", "scope": "both", "data": true, "why": "claims an earlier panel verified something" },
    { "id": "T-TOOL-NAME", "regex": "\\bgauntlet(?:[\\s_-]*runs?)?\\b", "flags": "i", "lang": "en", "scope": "both", "data": true, "why": "names the review tool or its run folder (\"gauntlet\", \"gauntlet-runs\")" },
    { "id": "T-ROUND-VERDICT-EN", "regex": "\\bround\\s*\\d+\\s*(?:scores?|verdicts?|feedback|reviews?)\\b", "flags": "i", "lang": "en", "scope": "both", "data": true, "why": "a score, verdict or feedback of a numbered earlier round (\"round 3 verdict\")" },
    { "id": "T-FEEDBACK-FILE", "regex": "ROUND\\d+[-_]FEEDBACK|FEEDBACK[-_]ROUND\\d*", "flags": "", "lang": "en", "scope": "both", "data": true, "why": "a feedback file of an earlier round (ROUND3-FEEDBACK, FEEDBACK_ROUND2)" },
    { "id": "T-FEEDBACK", "regex": "(?<![A-Z])FEEDBACK(?![A-Z])", "flags": "", "lang": "en", "scope": "both", "why": "review feedback files and headings (ROUND3-FEEDBACK.md)" },
    { "id": "T-LV-SCORE", "regex": "vidēj(?:ais|ā|o)\\s+(?:vērtējum|atzīm)", "flags": "i", "lang": "lv", "scope": "both", "why": "average score of earlier reviews (\"vidējais vērtējums\")" },
    { "id": "T-LV-REVIEWER", "regex": "(?<![\\p{L}])(?:recenzent|pārbaudītāj|vērtētāj)", "flags": "i", "lang": "lv", "scope": "both", "why": "mentions reviewers of the work" },
    { "id": "T-LV-ROUND", "regex": "(?<![\\p{L}])(?:kārt(?:a|ā|as)|raund(?:s|ā|a)?)[\\s_#-]*\\d", "flags": "i", "lang": "lv", "scope": "both", "why": "round number of an earlier review (\"kārta 3\")" },
    { "id": "T-LV-DELIBERATE", "regex": "(?<![\\p{L}])apzināti(?![\\p{L}])", "flags": "i", "lang": "lv", "scope": "both", "why": "tells readers a problem is intended (\"apzināti\")" },
    { "id": "P-REVIEW", "regex": "(?<![\\p{L}])review", "flags": "i", "lang": "en", "scope": "path", "why": "a folder or file name that says the work is under review (SPEC D26)" },
    { "id": "P-ROUND", "regex": "(?<![\\p{L}])rounds?(?![\\p{L}])", "flags": "i", "lang": "en", "scope": "path", "why": "a folder or file name with a round (SPEC D26)" },
    { "id": "P-PANEL", "regex": "(?<![\\p{L}])(?:panel|gauntlet)", "flags": "i", "lang": "en", "scope": "path", "why": "a folder or file name with panel or gauntlet, e.g. gauntlet-runs, gauntlet (SPEC D26)" },
    { "id": "P-BLIND", "regex": "(?<![\\p{L}])blind(?![\\p{L}])", "flags": "i", "lang": "en", "scope": "path", "why": "a folder name that says the copy is a blind review copy" },
    { "id": "P-FEEDBACK", "regex": "(?<![\\p{L}])feedback", "flags": "i", "lang": "en", "scope": "path", "why": "a feedback file or folder in lower case" },
    { "id": "P-SCORE", "regex": "(?<![\\p{L}])scor(?:e|es|ing)(?![\\p{L}])", "flags": "i", "lang": "en", "scope": "path", "why": "a scores file or folder" }
  ]
}
