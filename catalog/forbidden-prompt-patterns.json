{
  "schemaVersion": 1,
  "description": "Patterns that may never appear in a value substituted into a frozen template: task, requirements, lens fields, source notes, verifier item claims (SPEC 15.5). The frozen template text itself is not linted. Every regex is compiled with the flags shown plus 'g' and 'u'. Entries with class \"rating-word\" are also ordinary product words (a car valuation, an average price, a credit score): they are checked only in text the executor writes (source descriptions and notes, dispute arguments and evidence), never in the owner's task or in what the lens writer derives from it. Entries with class \"steering-word\" (\"is not an error\", \"is fine\", «допустимо») steer what reviewers count as a defect; they are ordinary words in an owner's task, so they too are checked only in text the executor writes. Entries without a class are loop-control constructs and are checked everywhere. Entries marked notNotes are skipped when the contents of author-notes files are linted (r3-f2): there numeric comparisons are ordinary facts.",
  "patterns": [
    { "id": "F-GE-SYMBOL", "regex": "≥\\s*\\d", "flags": "", "lang": "any", "notNotes": true, "why": "a threshold (\"≥ 9\"); not checked in author notes, where comparisons are ordinary facts (scores and 9.5 are caught by the trace scan there)" },
    { "id": "F-GE-ASCII", "regex": ">=\\s*\\d", "flags": "", "lang": "any", "notNotes": true, "why": "a threshold (\">= 9\"); not checked in author notes (see F-GE-SYMBOL)" },
    { "id": "F-9-5", "regex": "\\b9[.,]5\\b", "flags": "", "lang": "any", "why": "the old stop threshold 9.5 / 9,5" },
    { "id": "F-N-OF-10", "regex": "\\b\\d{1,2}[.,]\\d\\s*/\\s*10\\b", "flags": "", "lang": "any", "why": "a score written as N.N/10" },
    { "id": "F-AT-LEAST-POINTS", "regex": "\\bat\\s+least\\s+\\d+(?:[.,]\\d)?\\s*(?:points?|score)", "flags": "i", "lang": "en", "why": "a threshold (\"at least 9 points\")" },
    { "id": "F-THRESHOLD", "regex": "\\bthresholds?\\b", "flags": "i", "lang": "en", "why": "mentions a pass threshold" },
    { "id": "F-SCORE", "regex": "\\bscor(?:e|es|ed|ing)\\b", "flags": "i", "lang": "en", "class": "rating-word", "why": "asks for or mentions a score" },
    { "id": "F-OCENK-RU", "regex": "оценк(?:а|у|и|е|ой|ам|ами|ах)?(?![\\p{L}])", "flags": "i", "lang": "ru", "class": "rating-word", "why": "asks for or mentions a score (\"оценку\")" },
    { "id": "F-RATING", "regex": "\\bratings?\\b", "flags": "i", "lang": "en", "class": "rating-word", "why": "asks for or mentions a rating" },
    { "id": "F-AVERAGE", "regex": "\\baverag(?:e|es|ed|ing)\\b", "flags": "i", "lang": "en", "class": "rating-word", "why": "an average (stop by average)" },
    { "id": "F-SREDN-RU", "regex": "средн", "flags": "i", "lang": "ru", "class": "rating-word", "why": "an average (\"средний\")" },
    { "id": "F-NOT-AN-ERROR", "regex": "\\bnot\\s+(?:an?\\s+)?(?:error|issue|problem|bug|defect|mistake)s?\\b", "flags": "i", "lang": "en", "class": "steering-word", "why": "decides in advance what is not a defect (\"is not an error\")" },
    { "id": "F-IS-FINE", "regex": "\\b(?:is|are|looks?|considered|counts?\\s+as)\\s+(?:fine|acceptable|ok(?:ay)?)\\b", "flags": "i", "lang": "en", "class": "steering-word", "why": "decides in advance what passes (\"is fine\", \"acceptable\")" },
    { "id": "F-ACCEPTABLE", "regex": "\\bacceptable\\b", "flags": "i", "lang": "en", "class": "steering-word", "why": "decides in advance what passes (\"acceptable\")" },
    { "id": "F-NE-OSHIBKA-RU", "regex": "(?<![\\p{L}])не\\s+(?:является\\s+)?(?:ошибк|проблем|недочёт|недочет)", "flags": "i", "lang": "ru", "class": "steering-word", "why": "decides in advance what is not a defect (\"не ошибка\")" },
    { "id": "F-DOPUSTIMO-RU", "regex": "(?<![\\p{L}])(?:допустим[оаы]?|нормально)(?![\\p{L}])", "flags": "i", "lang": "ru", "class": "steering-word", "why": "decides in advance what passes (\"допустимо\", \"нормально\")" },
    { "id": "F-DO-NOT-FLAG", "regex": "\\b(?:do\\s+not|don['’]?t|never)\\s+flag", "flags": "i", "lang": "en", "why": "removes a topic from review (\"do not flag\")" },
    { "id": "F-NE-OTMECHAY-RU", "regex": "не\\s+отмечай", "flags": "i", "lang": "ru", "why": "removes a topic from review (\"не отмечай\")" },
    { "id": "F-NE-UKAZYVAY-RU", "regex": "не\\s+указывай", "flags": "i", "lang": "ru", "why": "removes a topic from review (\"не указывай\")" },
    { "id": "F-DELIBERATE", "regex": "\\bdeliberate(?:ly)?\\b", "flags": "i", "lang": "en", "why": "declares a problem intended (\"deliberate\")" },
    { "id": "F-NAMERENN-RU", "regex": "намеренн", "flags": "i", "lang": "ru", "why": "declares a problem intended (\"намеренно\")" },
    { "id": "F-OUT-OF-SCOPE", "regex": "\\bout\\s+of\\s+scope\\b", "flags": "i", "lang": "en", "why": "removes a topic from review (\"out of scope\")" },
    { "id": "F-VNE-RAMOK-RU", "regex": "вне\\s+рамок", "flags": "i", "lang": "ru", "why": "removes a topic from review (\"вне рамок\")" },
    { "id": "F-ALREADY-FIXED", "regex": "\\balready\\s+fixed\\b", "flags": "i", "lang": "en", "why": "executor-written history (\"already fixed\")" },
    { "id": "F-ISPRAVLENO-RU", "regex": "исправлено", "flags": "i", "lang": "ru", "why": "executor-written history (\"исправлено\")" },
    { "id": "F-DO-NOT-INVENT", "regex": "\\b(?:do\\s+not|don['’]?t)\\s+invent(?!or)", "flags": "i", "lang": "en", "why": "discourages new findings (\"do not invent\")" },
    { "id": "F-NE-PRIDUMYVAY-RU", "regex": "не\\s+придумывай", "flags": "i", "lang": "ru", "why": "discourages new findings (\"не придумывай\")" },
    { "id": "F-NOT-SUBSTANTIVE", "regex": "\\b(?:not|non)[\\s-]+substantive\\b", "flags": "i", "lang": "en", "why": "pre-judges findings as minor (\"not substantive\")" },
    { "id": "F-NESUSHCH-RU", "regex": "несущественн", "flags": "i", "lang": "ru", "why": "pre-judges findings as minor (\"несущественно\")" },
    { "id": "F-PREVIOUS-EN", "regex": "\\bprevious\\s+(?:rounds?|scores?|reviews?)\\b", "flags": "i", "lang": "en", "why": "history of earlier reviews (\"previous round\")" },
    { "id": "F-PREDYDUSH-RU", "regex": "предыдущ(?:ий|его|ем|ему|ие|их)\\s+круг", "flags": "i", "lang": "ru", "why": "history of earlier reviews (\"предыдущий круг\")" },
    { "id": "F-ONLY-COSMETIC", "regex": "\\b(?:only\\s+cosmetic|cosmetic\\s+only)\\b", "flags": "i", "lang": "en", "why": "tells reviewers what is left (\"only cosmetic left\")" },
    { "id": "F-LENIENT", "regex": "\\bbe\\s+(?:lenient|strict|generous|harsh|kind)\\b", "flags": "i", "lang": "en", "why": "steers reviewer severity (\"be lenient\")" },
    { "id": "F-UNTIL-PANEL-EN", "regex": "\\b(?:until|till)\\b[^.\\n]{0,60}\\b(?:panel|reviewers?|judges?)\\b", "flags": "i", "lang": "en", "why": "a loop-control line (\"until the panel says ...\")" },
    { "id": "F-UNTIL-PANEL-RU", "regex": "(?:пока|до\\s+тех\\s+пор)[^.\\n]{0,60}(?:панел|проверяющ|ревьюер)", "flags": "i", "lang": "ru", "why": "a loop-control line («пока панель не скажет ...»)" },
    { "id": "F-PANEL-RUN-RU", "regex": "(?:гоня|гони|прогоня)[^.\\n]{0,40}(?:панел|проверяющ|ревьюер)", "flags": "i", "lang": "ru", "why": "a loop-control line («гоняй панель ...»)" },
    { "id": "F-LV-SCORE", "regex": "(?<![\\p{L}])vērtējum", "flags": "i", "lang": "lv", "class": "rating-word", "why": "asks for or mentions a score (\"vērtējums\")" },
    { "id": "F-LV-DELIBERATE", "regex": "(?<![\\p{L}])apzināti(?![\\p{L}])", "flags": "i", "lang": "lv", "why": "declares a problem intended (\"apzināti\")" },
    { "id": "F-LV-AVERAGE", "regex": "(?<![\\p{L}])vidēj(?:ais|ā|o)\\s+(?:vērtējum|atzīm|rezultāt)", "flags": "i", "lang": "lv", "why": "an average score (\"vidējais vērtējums\")" },
    { "id": "F-ON-PURPOSE", "regex": "\\b(?:on\\s+purpose|by\\s+design|intentional(?:ly)?)\\b", "flags": "i", "lang": "en", "class": "steering-word", "why": "declares a problem intended (\"on purpose\", \"by design\", \"intentional\")" },
    { "id": "F-SPECIALNO-RU", "regex": "(?<![\\p{L}])(?:специально|сознательно|нарочно|умышленно)(?![\\p{L}])|так\\s+задуман", "flags": "i", "lang": "ru", "class": "steering-word", "why": "declares a problem intended («специально», «сознательно», «так задумано»)" },
    { "id": "F-LV-TISHI", "regex": "(?<![\\p{L}])tīši(?![\\p{L}])", "flags": "i", "lang": "lv", "class": "steering-word", "why": "declares a problem intended (\"tīši\")" },
    { "id": "F-FIX-CLAIM-EN", "regex": "\\b(?:corrected|resolved|addressed)\\b|\\b(?:was|were|been|now|already|is|are)\\s+(?:fixed|updated|checked|verified)\\b", "flags": "i", "lang": "en", "class": "steering-word", "why": "executor-written history or a claim that something was checked (\"corrected\", \"resolved\", \"was updated\", \"already verified\")" },
    { "id": "F-FIX-CLAIM-RU", "regex": "(?<![\\p{L}])(?:поправлен|исправлен|сверен|выверен|перепроверен|устранен|устранён)\\p{L}*", "flags": "i", "lang": "ru", "class": "steering-word", "why": "executor-written history or a claim that something was checked («поправлена», «сверены с прайсом», «устранено»)" },
    { "id": "F-LV-FIX-CLAIM", "regex": "(?<![\\p{L}])(?:izlabot|pārbaudīt)\\p{L}*", "flags": "i", "lang": "lv", "class": "steering-word", "why": "executor-written history or a claim that something was checked (\"izlabots\", \"pārbaudīts\")" }
  ]
}
