{
  "$id": "gauntlet/answer-planter.schema.json",
  "description": "Planter answer (SPEC 9.9, 14.3).",
  "type": "object",
  "required": [
    "schemaVersion",
    "nonce",
    "candidates",
    "incidental"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot",
          "alt",
          "file",
          "locator",
          "before",
          "after",
          "description",
          "howProvable",
          "intendedSeverity"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "alt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          },
          "before": {
            "type": "string",
            "minLength": 3
          },
          "after": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "howProvable": {
            "type": "string",
            "minLength": 1
          },
          "intendedSeverity": {
            "type": "string",
            "enum": [
              "blocker",
              "major"
            ]
          }
        }
      }
    },
    "incidental": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "locator",
          "note"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
