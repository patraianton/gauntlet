{
  "$id": "gauntlet/clusters.schema.json",
  "description": "clusters.json (SPEC 9.12): every cluster of the run with its status history.",
  "type": "object",
  "required": [
    "schemaVersion",
    "clusters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "origin",
          "members",
          "claimedSeverity",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C-[0-9]+-[0-9]+$"
          },
          "origin": {
            "type": "string",
            "enum": [
              "finding",
              "requirement",
              "incidental"
            ]
          },
          "requirementId": {
            "type": "string",
            "pattern": "^R[0-9]{2}$"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "round"
              ],
              "properties": {
                "round": {
                  "type": "integer",
                  "minimum": 1
                },
                "lens": {
                  "type": "string"
                },
                "job": {
                  "type": "string"
                },
                "n": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "blocker",
                    "major",
                    "cosmetic"
                  ]
                }
              }
            }
          },
          "claimedSeverity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "cosmetic"
            ]
          },
          "grounded": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "open",
              "cosmetic",
              "dropped",
              "closed",
              "waived",
              "unverified",
              "contested"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "blocker",
              "major",
              "cosmetic",
              null
            ]
          },
          "verifiedOn": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "to"
              ],
              "properties": {
                "round": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
