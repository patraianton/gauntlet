{
  "$id": "gauntlet/answer-reviewer.schema.json",
  "description": "Reviewer answer (SPEC 9.9). A sourceChecks entry may carry outcome \"unavailable\" (the source answered with an error, a block or nothing) with an excerpt of the error in result; a missing outcome means the attempt worked. Extra keys are allowed on purpose: score-like keys are ignored and logged by ingest, never a reason to reject. A quote is required unless kind is omission or visual (checked by ingest).",
  "type": "object",
  "required": [
    "schemaVersion",
    "nonce",
    "instructionReceived",
    "receipt",
    "inspected",
    "sourceChecks",
    "requirements",
    "findings",
    "notVerified",
    "notChecked"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "instructionReceived": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "receipt": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "inspected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "minimumId",
          "done",
          "how"
        ],
        "properties": {
          "minimumId": {
            "type": "string",
            "pattern": "^M[0-9]{1,2}$"
          },
          "done": {
            "type": "boolean"
          },
          "how": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "sourceChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "command",
          "result"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "result": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "where"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "present",
              "partial",
              "absent",
              "cannot-tell"
            ]
          },
          "where": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "severity",
          "kind",
          "location",
          "quote",
          "problem",
          "fix"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "cosmetic"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "number",
              "contradiction",
              "language",
              "path",
              "policy",
              "omission",
              "visual",
              "brief",
              "other"
            ]
          },
          "location": {
            "type": "object",
            "required": [
              "file",
              "locator"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string"
              }
            }
          },
          "quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote2": {
            "type": "string"
          },
          "seen": {
            "type": "string"
          },
          "missingWhat": {
            "type": "string"
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "severityWhy": {
            "type": "string"
          }
        }
      }
    },
    "notVerified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "whereLooked"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "whereLooked": {
            "type": "string"
          }
        }
      }
    },
    "notChecked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
