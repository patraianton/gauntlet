{
  "description": "Test double written by P5 from SPEC 9.9/9.6; the real schema lives in schemas/ (P1).",
  "type": "object",
  "required": [
    "schemaVersion",
    "nonce",
    "requirements",
    "lenses"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nonce": {
      "type": "string",
      "pattern": "^PL-[A-Z2-9]{4}-[A-Z2-9]{4}$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "taskQuote",
          "ifMissing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{2}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "taskQuote": {
            "type": "string",
            "minLength": 1
          },
          "ifMissing": {
            "type": "string",
            "enum": [
              "blocker",
              "major"
            ]
          }
        }
      },
      "minItems": 1
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "duty",
          "procedure",
          "checklist",
          "minimum",
          "canaryTypes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,23}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "duty": {
            "type": "string",
            "minLength": 1
          },
          "procedure": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 3
          },
          "checklist": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 5
          },
          "minimum": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "rule",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^M[0-9]{1,2}$"
                },
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "all-files",
                    "all-entries",
                    "source-check",
                    "action"
                  ]
                },
                "glob": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^/"
                },
                "sourceId": {
                  "type": "string",
                  "pattern": "^S[0-9]{1,2}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "minItems": 1
          },
          "canaryTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z-]*$"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 3,
      "maxItems": 7
    }
  }
}
